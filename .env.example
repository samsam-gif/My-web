# ==========================================
# AI COMPANY COMMAND CENTER CONFIGURATION
# ==========================================

# Server & Host Configuration
HOST=0.0.0.0
PORT=3000
BACKEND_PORT=8000
ENVIRONMENT=production

# Security & Authentication
JWT_SECRET_KEY=change-this-to-a-super-secret-key-in-production-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ROOT_CEO_PASSWORD=admin

# AI Model Provider API Keys (Configurable external models)
# The system operates even if no external key is configured (Fallback Mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL_PROVIDER=gemini
DEFAULT_MODEL_NAME=gemini-2.5-flash

# Database & Storage
DATABASE_URL=sqlite:///./ai_company.db
PROJECTS_DIR=./projects
LOGS_DIR=./logs
MEMORY_DIR=./memory

# Worker & Queue Settings
MAX_WORKER_CONCURRENCY=5
TASK_TIMEOUT_SECONDS=300
MAX_TASK_RETRIES=3
WORKER_HEARTBEAT_INTERVAL_SECONDS=5

# Autonomous Security & Sandboxing
ENFORCE_PROJECT_ISOLATION=true
AUTO_APPROVE_LOW_RISK=true
REQUIRE_APPROVAL_HIGH_RISK=true
